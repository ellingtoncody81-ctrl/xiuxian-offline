#!/bin/sh
# 提交信息规范校验（Conventional Commits）—— 见 CONTRIBUTING.md
# 启用：git config core.hooksPath tools/git-hooks
# 临时跳过：git commit --no-verify
msg_file="$1"
subject=$(sed -n '1p' "$msg_file")
case "$subject" in
  Merge*|Revert*|fixup!*|squash!*|"")
    exit 0 ;;
esac
pattern='^(feat|fix|docs|chore|refactor|perf|test|build|ci|style|revert)(\([a-z0-9._/-]+\))?!?: .{2,}'
if printf '%s' "$subject" | grep -Eq "$pattern"; then
  exit 0
fi
cat >&2 <<'EOF'
[commit-msg] 提交标题不符合规范，已阻止本次提交。

正确写法： <type>(<scope>): <描述>

  feat(arena):  竞技场支持跨服匹配
  fix(douluo):  详情页与战斗的仙侣改为同源
  docs:         修正 README 的启动步骤

  type  : feat | fix | docs | chore | refactor | perf | test | build | ci | style | revert
  scope : 小写英文（可省略），见 CONTRIBUTING.md

  标题只写"做了什么"（≤50 字，不加句号）；"为什么/怎么验证"写正文第二段。
  模板见 .gitmessage。临时跳过校验：git commit --no-verify
EOF
exit 1
